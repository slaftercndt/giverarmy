# Supabase — shared GiveSendGo Charities database (the project that backs givesendgo.org).
# These are OPTIONAL: lib/supabase.ts falls back to the public values below so the
# site renders live data without any config. Set them in Vercel to override per env.
#
# The publishable key is browser-safe by design — access is governed by Row Level
# Security, and only `stats` and published `impact_stories` rows are readable.
# Do NOT put the service-role key here; the public site never needs it.

NEXT_PUBLIC_SUPABASE_URL="https://nccijunvmyjyybnsbfyx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_6REix7uT6ZVz2oFDlMVqAQ_psCCZWBz"

# Canonical site URL — drives metadata, OpenGraph, canonical tags, sitemap, robots.
# Launch: giver.army is the main site (default). Later flip: set this to
# https://giverarmy.com and enable the giver.army -> giverarmy.com redirect in Vercel.
NEXT_PUBLIC_SITE_URL="https://giver.army"
