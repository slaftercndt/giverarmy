# Supabase — shared GSGC project (ref nccijunvmyjyybnsbfyx), the same backend
# givesendgo.org uses. REQUIRED: these are set in the Vercel dashboard and are
# read only via process.env — nothing is hardcoded in the repo. Without them
# the site builds fine and renders clearly-marked placeholders instead of live
# data.
#
# The anon key is browser-safe by design — access is governed by Row Level
# Security. Anon read currently exists ONLY on `stats` and published
# `impact_stories`. Do NOT put the service-role key here; the public site
# never needs it.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Canonical site URL — drives metadata, OpenGraph, canonical tags, sitemap,
# robots. Defaults to https://giver.army when unset. For the later flip, set
# this to https://giverarmy.com and enable the domain redirect in Vercel.
NEXT_PUBLIC_SITE_URL="https://giver.army"
